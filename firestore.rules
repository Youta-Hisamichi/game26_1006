rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1人1ドキュメント（ドキュメントID = 匿名ログインのuid）。最速タイムだけを保持する。
    match /scores/{uid} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data, uid);

      // 更新はタイムが縮まるときだけ
      allow update: if request.auth != null && request.auth.uid == uid
                    && validScore(request.resource.data, uid)
                    && (request.resource.data.t < resource.data.t || onlyNameChanged());

      allow delete: if false;
    }

    // 正確さランキング用：最高正確さの記録（同じく1人1ドキュメント）
    match /accuracy/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data, uid);
      allow update: if request.auth != null && request.auth.uid == uid
                    && validScore(request.resource.data, uid)
                    && (request.resource.data.a > resource.data.a || onlyNameChanged());
      allow delete: if false;
    }

    // 名前だけの変更（記録そのものは変えない）
    function onlyNameChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n']);
    }

    function validScore(d, uid) {
      return d.keys().hasOnly(['n', 't', 'a', 'd', 'u'])
        && d.keys().hasAll(['n', 't', 'a', 'd', 'u'])
        && d.u == uid
        && d.n is string && d.n.size() >= 1 && d.n.size() <= 8
        && (d.t is int || d.t is float) && d.t >= 1 && d.t < 100000
        && (d.a is int || d.a is float) && d.a >= 0 && d.a <= 1
        && d.d is int;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
